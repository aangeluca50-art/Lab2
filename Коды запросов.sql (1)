-- Вариант 40. Задание 1 - Выбрать все предменты из коллекции стеклянных доспехов
SELECT i.item.id, i.name, i.rarity, it.collection
FROM items i
JOIN item_types it ON i.type_id = it.type_id
WHERE i.rarity = 'Редкий'
	AND it.collection = 'Стеклянные доспехи';

-- Вариант 40. Задание 2 - Выбрать все железные кирасы, вероятность нахождения которых ниже 20%
SELECT i.item.id, i.name, it.spawn_probability
FROM items i
JOIN item_types it ON i.type_id = it.type_id
WHERE i.name LIKE '%кираса%'
	AND CAST(it.spawn_probability AS NUMERIC) < 0.20;

-- Вариант 40. Задание 3 - Создать таблицу из данных запроса 1
SELECT i.item.id, i.name, i.rarity, i.price, i.can_trade, i.can_sell, it.collection, it.spawn_probability
INTO glass_items
FROM items i
JOIN item_types it ON i.type_id = it.type_id
WHERE i.rarity = 'Редкий'
	AND it.collection = 'Стеклянные доспехи';

-- Вариант 40. Задание 4 - Добавить в созданную таблицу все предметы, стоимость которых кратна 200 руб.
INSERT INTO glass_items
SELECT i.item.id, i.name, i.rarity, i.price, i.can_trade, i.can_sell, it.collection, it.spawn_probability
FROM items i
JOIN item_types it ON i.type_id = it.type_id
WHERE MOD(i.price, 200) = 0;

-- Вариант 40. Задание 5 - В созданной таблицы уменьшить до гуля вероятность нахождения всех предметов, которых нужно продать
UPDATE glass_items
SET spawn_probability = '0'
WHERE can_sell = TRUE;

-- Вариант 40. Задание 6 - Удалить из созданнойтаблицы все предметы, характеристика которых состоит меньше, чем из 5 слов
DELETE FROM glass_items
WHERE array_length(string_to_array(trim(name), ' '), 1) < 5;

-- Вариант 40. Задание 7 - Посчитать среднюю вероятность нахаждения в игре для каждого наименования предмета одежды
SELECT i.name,
       AVG(CAST(it.spawn_probability AS NUMERIC)) AS avg_probability
FROM items i
JOIN item_types it ON i.type_id = it.type_id
WHERE it.is_clothing = TRUE
GROUP BY i.name;